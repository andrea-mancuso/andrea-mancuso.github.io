---
// Logo motif: a tiny truck-and-drone solution. The truck tour (accent) starts at the
// depot (square); the drone (teal, dashed) leaves the truck, serves one customer and lands
// further along the tour.
interface Props {
  size?: number;
  class?: string;
}
const { size = 26, class: cls } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <path d="M5 25 L10 8 L23 5 L28 19 L17 28 Z" fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linejoin="round" opacity="0.75" />
  <path d="M10 8 L17.5 16 L28 19" fill="none" stroke="var(--drone)" stroke-width="1.5" stroke-dasharray="2 1.8" stroke-linecap="round" />
  <rect x="2.6" y="22.6" width="4.8" height="4.8" rx="0.8" fill="var(--warm)" />
  <g fill="var(--accent)">
    <circle cx="10" cy="8" r="2.4" /><circle cx="23" cy="5" r="2.4" />
    <circle cx="28" cy="19" r="2.4" /><circle cx="17" cy="28" r="2.4" />
  </g>
  <circle cx="17.5" cy="16" r="2.6" fill="var(--drone)" />
</svg>
