---
import { PUB_TYPES, type Publication } from '../lib/data';

interface Props {
  pub: Publication;
  showCite?: boolean;
}
const { pub, showCite = true } = Astro.props;
const typeLabel = PUB_TYPES[pub.type] || pub.type;
const searchText = [pub.title, pub.venue, pub.abbr, ...pub.authors.map((a) => a.name)].join(' ').toLowerCase();
// Papers under review show their status ("Under review (second round), ...") instead of the venue.
const underReview = pub.type === 'submitted';
const cite = showCite ? pub.cite : null;
const citeId = `cite-${pub.key}`;
const absId = `abstract-${pub.key}`;
const hasAbstract = showCite && pub.abstract.length > 0;
const article = pub.links.find((l) => l.label === 'Article');
const pdf = pub.links.find((l) => l.label === 'PDF');
const dataUri = (mime: string, text: string) => `data:${mime};charset=utf-8,${encodeURIComponent(text)}`;
---
<li class="pub" id={pub.key} data-type={pub.type} data-year={pub.year} data-search={searchText}>
  <div class="pub-meta">
    {pub.abbr && <span class="badge">{pub.abbr}</span>}
    {pub.quartile && (
      <a
        class={`badge quartile ${pub.quartile.q.toLowerCase()}`}
        href={pub.quartile.url || 'https://www.scimagojr.com'}
        rel="noopener"
        title={`SCImago Journal Rank ${pub.quartile.year}: best quartile ${pub.quartile.q}`}
        aria-label={`SCImago Journal Rank ${pub.quartile.year}: ${pub.quartile.q}`}
      >{pub.quartile.q}<span class="q-src">SJR</span></a>
    )}
    <span class="badge neutral">{typeLabel}</span>
  </div>
  <div>
    <p class="pub-title">{pub.title}</p>
    <p class="pub-authors">
      {pub.authorRole === 'editors' && <span class="muted">Eds.: </span>}
      {pub.authors.map((a, i) => (
        <>
          {a.me ? <strong>{a.name}</strong> : a.name}
          {i < pub.authors.length - 1 ? ', ' : ''}
        </>
      ))}
      {pub.nonAlpha && <sup class="dagger" title="Authors not in alphabetical order">†</sup>}
    </p>
    <p class="pub-venue">
      {underReview ? (
        <em>{pub.note || `Under review, ${pub.venue}`}</em>
      ) : (
        <><em>{pub.venue}</em>{pub.details && `, ${pub.details}`}, {pub.year}</>
      )}
    </p>
    {pub.award && <p class="pub-award"><span class="badge warm">★ {pub.award}</span></p>}
    <div class="pub-links">
      {pub.links.map((l) => (
        <a href={l.url} rel="noopener" aria-label={`${l.label}: ${pub.title}`}>{l.label}</a>
      ))}
      {hasAbstract && (
        <button type="button" class="pub-abs" data-cite-open={absId} aria-haspopup="dialog" aria-label={`Abstract: ${pub.title}`}>
          Abstract
        </button>
      )}
      {cite && (
        <button type="button" class="pub-cite" data-cite-open={citeId} aria-haspopup="dialog" aria-label={`Cite: ${pub.title}`}>
          Cite
        </button>
      )}
    </div>
  </div>
  {hasAbstract && (
    <dialog class="cite-dialog abs-dialog" id={absId} aria-labelledby={`${absId}-h`}>
      <div class="cite-inner">
        <div class="cite-head">
          <h2 id={`${absId}-h`}>Abstract</h2>
          <button type="button" class="cite-close" data-cite-close aria-label="Close">&times;</button>
        </div>
        <p class="abs-title">{pub.title}</p>
        <p class="abs-meta">
          {pub.authors.map((a, i) => (
            <>
              {a.me ? <strong>{a.name}</strong> : a.name}
              {i < pub.authors.length - 1 ? ', ' : ''}
            </>
          ))}
          <br />
          {underReview ? <em>{pub.note || pub.venue}</em> : <><em>{pub.venue}</em>, {pub.year}</>}
        </p>
        <div class="abs-text">
          {pub.abstract.map((p) => <p>{p}</p>)}
        </div>
        <div class="abs-foot">
          {article && <a class="btn-small" href={article.url} rel="noopener">Article</a>}
          {pdf && <a class="btn-small" href={pdf.url} rel="noopener">PDF</a>}
          {cite && <button type="button" class="btn-small" data-cite-open={citeId}>❝ Cite</button>}
        </div>
      </div>
    </dialog>
  )}
  {cite && (
    <dialog class="cite-dialog" id={citeId} aria-labelledby={`${citeId}-h`}>
      <div class="cite-inner">
        <div class="cite-head">
          <h2 id={`${citeId}-h`}>Cite</h2>
          <button type="button" class="cite-close" data-cite-close aria-label="Close">&times;</button>
        </div>
        <p class="cite-paper">{pub.title}</p>
        <div class="cite-styles">
          {cite.styles.map((s) => (
            <div class="cite-row" data-copy-box>
              <span class="cite-name">{s.name}</span>
              <div class="cite-text" data-copy-src data-copy-html set:html={s.html} />
              <button type="button" class="btn-small" data-copy aria-label={`Copy ${s.name} citation`}>Copy</button>
            </div>
          ))}
        </div>
        <div class="cite-bib" data-copy-box>
          <div class="cite-bib-head">
            <span class="cite-name">BibTeX</span>
            <button type="button" class="btn-small" data-copy aria-label="Copy BibTeX">Copy</button>
          </div>
          <pre data-copy-src><code>{pub.bibtex}</code></pre>
        </div>
        <div class="cite-foot">
          {cite.doi && (
            <span class="cite-doi" data-copy-box>
              DOI <a href={`https://doi.org/${cite.doi}`} rel="noopener" data-copy-src>{cite.doi}</a>
              <button type="button" class="btn-small" data-copy aria-label="Copy DOI">Copy</button>
            </span>
          )}
          <span class="cite-downloads">
            <a class="btn-small" href={dataUri('application/x-bibtex', pub.bibtex + '\n')} download={`${pub.key}.bib`}>BibTeX ↓</a>
            <a class="btn-small" href={dataUri('application/x-research-info-systems', cite.ris)} download={`${pub.key}.ris`} title="For EndNote, Zotero, Mendeley">RIS ↓</a>
          </span>
        </div>
      </div>
    </dialog>
  )}
</li>
