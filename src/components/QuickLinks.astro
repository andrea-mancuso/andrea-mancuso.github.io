---
import Icon from './Icon.astro';
import { profile, url } from '../lib/data';

const l = profile.links;
const items = [
  l.email && { href: `mailto:${l.email}`, label: 'Email', icon: 'email', primary: true },
  l.university_page && { href: l.university_page, label: 'UniNA', icon: 'university' },
  l.cv_pdf && { href: url(l.cv_pdf), label: 'CV (PDF)', icon: 'cv' },
  l.scholar && { href: l.scholar, label: 'Scholar', long: 'Google ', icon: 'scholar' },
  l.scopus && { href: l.scopus, label: 'Scopus', icon: 'scopus' },
  l.orcid && { href: l.orcid, label: 'ORCID', icon: 'orcid' },
  l.github && { href: l.github, label: 'GitHub', icon: 'github' },
  l.linkedin && { href: l.linkedin, label: 'LinkedIn', icon: 'linkedin' },
  l.dblp && { href: l.dblp, label: 'dblp', icon: 'dblp' },
].filter(Boolean) as { href: string; label: string; long?: string; icon: string; primary?: boolean }[];
// Two balanced rows when the links don't fit on one line.
const cols = Math.ceil(items.length / 2);
---
<div class="ql-wrap">
<ul class="quick-links" style={`--ql-cols:${cols}`}>
  {items.map((i) => (
    <li class={i.primary ? 'primary' : undefined}>
      <a href={i.href} rel={i.href.startsWith('http') ? 'noopener me' : undefined}>
        <Icon name={i.icon} />
        <span>{i.long && <span class="ql-long">{i.long}</span>}{i.label}</span>
      </a>
    </li>
  ))}
</ul>
</div>
